# ---- Mode -------------------------------------------------------------------
# production | demo | test   (mock AI and fake Telegram are refused in production)
APP_MODE=production
# all = bot (updates) + worker (scheduler, jobs) in one process; or run "bot" and "worker" separately
PROCESS_ROLE=all
LOG_LEVEL=info
LOG_PRETTY=false

# ---- Telegram ---------------------------------------------------------------
# From @BotFather. Never commit the real token.
BOT_TOKEN=
# Comma-separated numeric Telegram user ids of the teachers who administer the bot (ask @userinfobot).
# Being a Telegram group admin does NOT grant bot-admin access.
BOT_ADMIN_IDS=
# polling (local development) | webhook (VPS). Never both.
TELEGRAM_MODE=polling
# Webhook mode only: public HTTPS base URL (port 443/80/88/8443) and a random secret (16-256 of A-Z a-z 0-9 _ -)
# On Railway leave WEBHOOK_URL empty: it defaults to https://$RAILWAY_PUBLIC_DOMAIN
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_PATH=/telegram/webhook
# Leave empty on Railway (it injects PORT); default 8080
HTTP_PORT=
HTTP_HOST=0.0.0.0
TELEGRAM_SEND_TIMEOUT_MS=15000
# Random string (>= 16 chars) used to sign inline button data. Changing it invalidates open buttons.
CALLBACK_SECRET=

# ---- Database ---------------------------------------------------------------
# Railway: the bot service gets DATABASE_URL from the Railway Postgres automatically (.railway/railway.ts).
# From your PC (db:check, migrate, seed, pg_dump): enable Public Networking on Postgres and use its
# DATABASE_PUBLIC_URL with ?sslmode=require, e.g. postgresql://postgres:***@xxx.proxy.rlwy.net:12345/railway?sslmode=require
# Local Windows dev with `npm run db:local`:
DATABASE_URL=postgres://gamebot:gamebot@localhost:54340/gamebot
# Only for a pooled endpoint (e.g. Neon "-pooler"): the direct URL used for migrations + job queue
DATABASE_DIRECT_URL=
DATABASE_POOL_MAX=10
# docker-compose.yml (own server with a PostgreSQL container) only
POSTGRES_PASSWORD=

# ---- Defaults for new groups ------------------------------------------------
DEFAULT_TIMEZONE=Asia/Tashkent
DEFAULT_LANGUAGE=uz

# ---- AI (server-side only) --------------------------------------------------
# openai (default) | anthropic | none   (mock = demo/test only)
AI_PROVIDER=openai
# OpenAI API key from https://platform.openai.com (API billing is separate from a ChatGPT subscription)
OPENAI_API_KEY=
# Optional, e.g. a regional/data-residency endpoint
# OPENAI_BASE_URL=
# Used only when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Leave empty for the provider default: openai -> gpt-6-luna, anthropic -> claude-opus-5-5.
# Each role can use another model id, e.g. AI_GENERATION_MODEL=gpt-6-sol for harder generation.
AI_GENERATION_MODEL=
AI_REVIEW_MODEL=
AI_GRADING_MODEL=
AI_VISION_MODEL=
# Reasoning effort: low | medium | high | xhigh | max (gpt-6-luna also supports them)
AI_GENERATION_EFFORT=high
AI_REVIEW_EFFORT=high
AI_GRADING_EFFORT=medium
# Anthropic only: server-side refusal fallback (default) or off
AI_REFUSAL_FALLBACK=default
AI_TIMEOUT_MS=180000
AI_MAX_ATTEMPTS=3
AI_GENERATION_CONCURRENCY=1
AI_GRADING_CONCURRENCY=4
# Optional price overrides (USD per 1M tokens) for budget tracking:
# AI_PRICING_JSON={"gpt-6-luna":{"input":0.1,"output":0.5}}

# ---- Documents --------------------------------------------------------------
UPLOAD_MAX_BYTES=10485760
PDF_MAX_PAGES=80
EXTRACT_TIMEOUT_MS=60000
EXTRACT_CONCURRENCY=1
# OCR for scanned PDFs/images (tesseract.js; downloads language data on first use into .data/tessdata)
OCR_ENABLED=false
OCR_LANGS=uzb+uzb_cyrl+eng+rus
OCR_MAX_PAGES=10
OCR_TIMEOUT_MS=180000
# OCR_LANG_PATH=/app/.data/tessdata-local
RAW_FILE_RETENTION_DAYS=30

# ---- Scheduler --------------------------------------------------------------
TICK_INTERVAL_MS=1000
# Unpublished questions later than this after their slot are skipped (never flood the group after downtime)
PUBLISH_GRACE_SECONDS=120
# Poll votes that arrive this long after the deadline still count (Telegram stops the poll at the deadline)
POLL_ANSWER_GRACE_SECONDS=15
# How long the daily report waits for pending AI grading before publishing with "pending" markers
REPORT_GRADING_WAIT_SECONDS=120
